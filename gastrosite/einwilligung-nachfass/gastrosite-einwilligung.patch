+
+// ---------- Mini-Datenbank im Speicher (nur was die Entwurfs-Abläufe brauchen) ----------
+const tables = { drafts: [] };
+const rows = (t) => (tables[t] ??= []);
+const parseVal = (v) => (v === "null" ? null : v);
+const orPart = (part) => {
+  const [col, ...rest] = part.split(".");
+  const neg = rest[0] === "not";
+  const [op, val] = neg ? rest.slice(1) : rest;
+  const test1 = (r) => (op === "is" ? (r[col] ?? null) === parseVal(val) : op === "neq" ? r[col] !== val : r[col] === val);
+  return (r) => (neg ? !test1(r) : test1(r));
+};
+const query = (table) => {
+  const filters = [];
+  let action = "select";
+  let payload = null;
+  let head = false;
+  let single = null;
+  let limit = Infinity;
+  const q = {
+    select: (_c, opts) => { if (action === "select") head = !!opts?.head; return q; },
+    insert: (v) => { action = "insert"; payload = v; return q; },
+    update: (v) => { action = "update"; payload = v; return q; },
+    delete: () => { action = "delete"; return q; },
+    eq: (c, v) => { filters.push((r) => r[c] === v); return q; },
+    neq: (c, v) => { filters.push((r) => r[c] !== v); return q; },
+    is: (c, v) => { filters.push((r) => (r[c] ?? null) === v); return q; },
+    not: (c, op, v) => { filters.push((r) => (op === "is" ? (r[c] ?? null) !== v : true)); return q; },
+    in: (c, vs) => { filters.push((r) => vs.includes(r[c])); return q; },
+    gt: (c, v) => { filters.push((r) => r[c] != null && r[c] > v); return q; },
+    gte: (c, v) => { filters.push((r) => r[c] != null && r[c] >= v); return q; },
+    lt: (c, v) => { filters.push((r) => r[c] != null && r[c] < v); return q; },
+    lte: (c, v) => { filters.push((r) => r[c] != null && r[c] <= v); return q; },
+    or: (s) => { const parts = s.split(",").map(orPart); filters.push((r) => parts.some((f) => f(r))); return q; },
+    order: () => q,
+    limit: (n) => { limit = n; return q; },
+    single: () => { single = "single"; return q; },
+    maybeSingle: () => { single = "maybe"; return q; },
+    then: (ok, ko) => Promise.resolve().then(run).then(ok, ko),
+  };
+  const run = () => {
+    const all = rows(table);
+    const match = () => all.filter((r) => filters.every((f) => f(r))).slice(0, limit);
+    let data;
+    if (action === "insert") {
+      const r = { id: crypto.randomUUID(), created_at: new Date().toISOString(), status: "generating", views: 0, ...payload };
+      all.push(r);
+      data = [r];
+    } else if (action === "update") {
+      data = match();
+      data.forEach((r) => Object.assign(r, payload));
+    } else if (action === "delete") {
+      data = match();
+      tables[table] = all.filter((r) => !data.includes(r));
+    } else data = match();
+    if (head) return { count: data.length, error: null };
+    if (single) return { data: data[0] ?? null, error: single === "single" && !data[0] ? { message: "keine Zeile" } : null };
+    return { data: data.map((r) => ({ ...r })), error: null };
+  };
+  return q;
+};
