diff -ruN a/src/lib/useNoindex.js b/src/lib/useNoindex.js
--- a/src/lib/useNoindex.js	1970-01-01 01:00:00
+++ b/src/lib/useNoindex.js	2026-10-17 02:03:31
@@ -0,0 +1,12 @@
+import { useEffect } from "react";
+
+// Private Seiten (z. B. Entwürfe mit Restaurantnamen): Robots-Meta auf noindex setzen, beim Verlassen zurückstellen.
+// Der Header X-Robots-Tag aus netlify.toml gilt zusätzlich; das Meta-Tag deckt die gerenderte Seite ab.
+export const useNoindex = () => {
+  useEffect(() => {
+    const meta = document.querySelector('meta[name="robots"]') || document.head.appendChild(Object.assign(document.createElement("meta"), { name: "robots" }));
+    const prev = meta.getAttribute("content");
+    meta.setAttribute("content", "noindex, nofollow");
+    return () => { if (prev) meta.setAttribute("content", prev); else meta.remove(); };
+  }, []);
+};
