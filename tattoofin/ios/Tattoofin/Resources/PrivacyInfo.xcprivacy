<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Datenschutz-Manifest der Tattoofin-App. Kein Tracking, keine Werbe-IDs, keine Analyse-Dienste.
     Erhoben wird nur, was die App für ihre Funktion braucht (alles mit dem Studio verknüpft, Zweck App Functionality):
     EmailAddress: Anmeldung, E-Mail von Kunden/Käufern · Name: Inhaber/in und Unterzeichner (Konto anlegen), Namen von Kunden/Käufern/Empfängern
     PhysicalAddress: Anschrift des Studios (Konto anlegen) · PhoneNumber: Mobilnummer und Telefonnummer des Studios (Konto anlegen)
     DeviceID: Geräte-Kennung und Push-Token (angemeldete Geräte, Mitteilungen)
     OtherUserContent: Freitext (Motiv/Beschreibung, Sitzungen, Gutschein-Nachricht, Notiz beim Einlösen, Grund beim Löschen)
     OtherFinancialInfo: Zahlungsbeträge, Zahlungen, Auszahlungen, Bank und letzte 4 Ziffern des Bankkontos
     OtherDataTypes: Gerätename, Gerätemodell, iOS- und App-Version (Liste der angemeldeten Geräte), Firmenname, USt-IdNr., Website (Konto anlegen)
     PurchaseHistory: Apple-Abo (In-App-Kauf): signierte Transaktion mit Kennungen, Produkt, Kauf-/Ablaufdatum an unseren Server
     Die Angaben „App-Datenschutz“ in App Store Connect genau gleich ausfüllen (tattoofin/ios/AppStore/README.md). -->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhysicalAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
